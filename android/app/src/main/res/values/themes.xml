<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ranch_background">#0B100C</color>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ranch_background</item>
        <item name="android:statusBarColor">@color/ranch_background</item>
        <item name="android:navigationBarColor">@color/ranch_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Keep the page below the status bar on Android 15 -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
